{
  "about": "The details sheet of a library piece: every copy of the rules (the port of server/furniture_library.php, the install's house3d_library.py, and views/live_aboard_library.js) must give the same answer, the FIRST problem as {field, problem}, or none. The order: not an object; then any key outside the sheet (in the sheet's own order); then a required field missing (category, kind, rooms, style, material, color_family, size_class); then each field in the sheet's order. Each case starts from 'details' (or only its 'only' keys), drops 'drop', then sets 'set'.",
  "kind": "sofa",
  "details": {"category": "seating", "kind": "sofa", "rooms": ["living"], "style": "mid-century",
              "material": "fabric", "color_family": "grey", "size_class": "large", "seats": 3,
              "features": ["has_arms"], "outdoor": false, "title": "Three-seat grey sofa, slim arms",
              "brand": "", "model": "", "checked": true},
  "cases": [
    {"name": "the plan's own sheet", "set": {}, "field": null},
    {"name": "only the required fields", "only": ["category", "kind", "rooms", "style", "material", "color_family", "size_class"], "field": null},
    {"name": "no category", "drop": ["category"], "field": "category", "problem": "missing"},
    {"name": "no kind", "drop": ["kind"], "field": "kind", "problem": "missing"},
    {"name": "no rooms", "drop": ["rooms"], "field": "rooms", "problem": "missing"},
    {"name": "no rooms ticked", "set": {"rooms": []}, "field": "rooms", "problem": "missing"},
    {"name": "no style", "drop": ["style"], "field": "style", "problem": "missing"},
    {"name": "a blank style", "set": {"style": ""}, "field": "style", "problem": "missing"},
    {"name": "no material", "drop": ["material"], "field": "material", "problem": "missing"},
    {"name": "no colour family", "drop": ["color_family"], "field": "color_family", "problem": "missing"},
    {"name": "no size class", "drop": ["size_class"], "field": "size_class", "problem": "missing"},
    {"name": "a style off the list", "set": {"style": "baroque"}, "field": "style", "problem": "value"},
    {"name": "a material off the list", "set": {"material": "jade"}, "field": "material", "problem": "value"},
    {"name": "a colour family off the list", "set": {"color_family": "gold"}, "field": "color_family", "problem": "value"},
    {"name": "a size class off the list", "set": {"size_class": "huge"}, "field": "size_class", "problem": "value"},
    {"name": "a category off the list", "set": {"category": "sofas"}, "field": "category", "problem": "value"},
    {"name": "a room off the list", "set": {"rooms": ["living", "attic"]}, "field": "rooms", "problem": "value"},
    {"name": "a room twice", "set": {"rooms": ["living", "living"]}, "field": "rooms", "problem": "value"},
    {"name": "rooms as one word", "set": {"rooms": "living"}, "field": "rooms", "problem": "value"},
    {"name": "every room", "set": {"rooms": ["any", "patio", "garage", "hallway", "bathroom", "office", "dining", "kitchen", "kids-room", "bedroom", "living"]}, "field": null},
    {"name": "another builder's kind", "set": {"kind": "bed"}, "field": "kind", "problem": "value"},
    {"name": "kind other", "set": {"kind": "other"}, "field": null},
    {"name": "nine seats", "set": {"seats": 9}, "field": "seats", "problem": "value"},
    {"name": "no seats", "set": {"seats": 0}, "field": "seats", "problem": "value"},
    {"name": "seats as text", "set": {"seats": "3"}, "field": "seats", "problem": "value"},
    {"name": "seats as a fraction", "set": {"seats": 2.5}, "field": "seats", "problem": "value"},
    {"name": "a feature off the list", "set": {"features": ["massage"]}, "field": "features", "problem": "value"},
    {"name": "no features at all", "set": {"features": []}, "field": null},
    {"name": "every feature", "set": {"features": ["wall_mounted", "adjustable_height", "foldable", "on_wheels", "storage", "sofa_bed", "sectional", "reclines", "has_arms"]}, "field": null},
    {"name": "drawers, doors and shelves", "set": {"drawers": 6, "doors": 2, "shelves": 0}, "field": null},
    {"name": "fifty-one drawers", "set": {"drawers": 51}, "field": "drawers", "problem": "value"},
    {"name": "a bed size", "set": {"bed_size": "queen"}, "field": null},
    {"name": "a bed size off the list", "set": {"bed_size": "california"}, "field": "bed_size", "problem": "value"},
    {"name": "a lamp's fixture and shades", "set": {"fixture": "floor", "shades": 2}, "field": null},
    {"name": "a fixture off the list", "set": {"fixture": "chandelier"}, "field": "fixture", "problem": "value"},
    {"name": "thirteen shades", "set": {"shades": 13}, "field": "shades", "problem": "value"},
    {"name": "a tag's form and antenna", "set": {"form": "puck", "antenna": true}, "field": null},
