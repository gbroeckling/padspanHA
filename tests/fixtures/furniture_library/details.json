    {"name": "antenna as text", "set": {"antenna": "yes"}, "field": "antenna", "problem": "value"},
    {"name": "outdoor as text", "set": {"outdoor": "no"}, "field": "outdoor", "problem": "value"},
    {"name": "checked as a number", "set": {"checked": 1}, "field": "checked", "problem": "value"},
    {"name": "a key outside the sheet", "set": {"price": 300}, "field": "price", "problem": "key"},
    {"name": "the name it has in the house", "set": {"label": "Mum's old couch"}, "field": "label", "problem": "key"},
    {"name": "a room name", "set": {"room": "Lounge"}, "field": "room", "problem": "key"},
    {"name": "a two-letter title", "set": {"title": "So"}, "field": "title", "problem": "length"},
    {"name": "a three-letter title", "set": {"title": "Bed"}, "field": null},
    {"name": "a 60-character title", "set": {"title": "Long low grey three-seat sofa with slim arms and oak legs ok"}, "field": null},
    {"name": "a 61-character title", "set": {"title": "Long low grey three-seat sofa with slim arms and oak legs ok!"}, "field": "title", "problem": "length"},
    {"name": "a blank title is no title", "set": {"title": "   "}, "field": null},
    {"name": "spaces round a title do not count", "set": {"title": "  So  "}, "field": "title", "problem": "length"},
    {"name": "a title as a number", "set": {"title": 7}, "field": "title", "problem": "value"},
    {"name": "a one-letter brand", "set": {"brand": "I"}, "field": "brand", "problem": "length"},
    {"name": "a two-letter brand", "set": {"brand": "LG"}, "field": null},
    {"name": "a one-character model", "set": {"model": "X"}, "field": null},
    {"name": "a title with an email address", "set": {"title": "Sofa - bob@example.com"}, "field": "title", "problem": "email"},
    {"name": "a title with a phone number", "set": {"title": "Call 604 555 0123"}, "field": "title", "problem": "phone"},
    {"name": "a title with a street address", "set": {"title": "From 42 Maple Street"}, "field": "title", "problem": "address"},
    {"name": "a title with a web address", "set": {"title": "See sofas.com"}, "field": "title", "problem": "url"},
    {"name": "a title with a token", "set": {"title": "0123456789abcdef0123456789abcdef"}, "field": "title", "problem": "secret"},
    {"name": "a title with a word the library does not take", "set": {"title": "Shitty old couch"}, "field": "title", "problem": "word"},
    {"name": "a brand with an email address", "set": {"brand": "bob@example.com"}, "field": "brand", "problem": "email"},
    {"name": "a model with a phone number", "set": {"model": "604-555-0123"}, "field": "model", "problem": "phone"},
    {"name": "two wrong values: the first in the sheet's order", "set": {"material": "jade", "style": "baroque"}, "field": "style", "problem": "value"},
    {"name": "a missing field comes before a wrong one", "drop": ["material"], "set": {"style": "baroque"}, "field": "material", "problem": "missing"},
    {"name": "a key outside the sheet comes first of all", "drop": ["category"], "set": {"zzz": 1}, "field": "zzz", "problem": "key"},
    {"name": "a sheet that is a list", "whole": ["seating"], "field": "details", "problem": "value"},
    {"name": "a sheet that is text", "whole": "seating", "field": "details", "problem": "value"}
  ]
}
